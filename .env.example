# Optional SMTP settings for live email delivery from the Contact Us form
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kygon Groups Website <no-reply@kygongroups.com>"
